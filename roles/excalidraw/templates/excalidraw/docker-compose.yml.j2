services:
  excalidraw:
    image: "{{ excalidraw_image }}"
    container_name: excalidraw
    restart: unless-stopped
    ports:
      - "{{ excalidraw_bind_host }}:{{ excalidraw_service_port }}:80"
    environment:
      - NODE_ENV=production
    volumes:
      - /etc/localtime:/etc/localtime:ro
    deploy:
      resources:
        limits:
          memory: {{ excalidraw_memory_limit }}
